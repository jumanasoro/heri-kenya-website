---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import heroImage from '../assets/images/home/eco-tour-visitors.jpg';
import { donateHref, externalLink } from '../data/site';

// Public link to the Google Form (the old site linked to the form's /edit page, which visitors can't open).
const bookingForm =
  'https://docs.google.com/forms/d/e/1FAIpQLScOb0kr9yLlBQT9DvQtOclXMf6CARK2uo_hlL-1eFb8ReXHaQ/viewform';

const hosts = [
  { name: 'Betty', phone: '+254 792 416 168' },
  { name: 'Agnes', phone: '+254 748 337 084' },
];

const modules = [
  {
    icon: '♻️',
    title: 'Organic waste flow & systems thinking',
    points: ['Sources and types of organic waste', 'Segregation and collection principles', 'Risk management and hygiene'],
  },
  {
    icon: '🪰',
    title: 'Black Soldier Fly farming in practice',
    points: ['BSF life cycle and biology', 'Larvae production and waste conversion', 'Infrastructure and operations'],
  },
  {
    icon: '🌱',
    title: 'Circular economy outputs',
    points: ['Larvae as protein for animal feed', 'Frass as organic fertiliser', 'Economic and environmental value chains'],
  },
  {
    icon: '🧑🏽‍🏫',
    title: 'Community training & replication',
    points: ['Community-based BSF adoption models', 'Youth and women participation', 'Scaling waste solutions responsibly'],
  },
];

const audiences = [
  'Eco-conscious tourists',
  'Farmers, youth and women’s groups',
  'Schools, colleges and universities',
  'Researchers and sustainability professionals',
  'Hotels, restaurants and hospitality operators',
  'Companies exploring CSR, ESG and waste reduction',
  'Donors and development partners',
];

const supports = [
  'More organic waste processing capacity',
  'Community training and skills development',
  'Evidence for policy and advocacy',
  'Livelihoods for youth and women',
  'Environmental and public health protection',
];
---

<Base
  title="Learning & Eco-Tours"
  description="Book a guided learning and eco-tour of the HERI Black Soldier Fly Farm in Diani — in person or virtual — and see food waste become feed and fertiliser."
>
  <PageHero
    eyebrow="Learning & eco-tours"
    title="Discover a different side of Diani"
    lead="Join a guided tour of the HERI Black Soldier Fly Farm and see food waste transformed from a health risk into organic compost and protein-rich animal feed — on real systems, not simulations."
    image={heroImage}
    imageAlt="International visitors with HERI staff at the farm in Diani"
    crumbs={[{ label: 'Eco-Tours', href: '/learning-eco-tours/' }]}
  >
    <div class="btn-row">
      <a class="btn btn--primary" href={bookingForm} rel="noopener" target="_blank">Book a tour</a>
      <a class="btn btn--outline" href="/projects/heri-black-soldier-fly-farm/tour/">Try the virtual tour</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What you’ll learn</span>
        <h2>From awareness to understanding</h2>
      </div>
      <ul class="modules">
        {
          modules.map((m) => (
            <li>
              <span class="icon" aria-hidden="true">
                {m.icon}
              </span>
              <h3>{m.title}</h3>
              <ul>
                {m.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container two">
      <div>
        <span class="eyebrow">Who the tours are for</span>
        <h2>Visitors of every kind</h2>
        <ul class="pills">
          {audiences.map((a) => <li>{a}</li>)}
        </ul>
      </div>
      <div>
        <span class="eyebrow">Beyond the tour</span>
        <h2>Every visit supports</h2>
        <ul class="ticks">
          {supports.map((s) => <li>{s}</li>)}
        </ul>
        <a class="link-arrow" href={donateHref} {...externalLink}>Or support the farm with a gift</a>
      </div>
    </div>
  </section>

  <section class="section" id="book">
    <div class="container book">
      <div>
        <span class="eyebrow">Plan your visit</span>
        <h2>Book in person or online</h2>
        <p class="lead">Fill in the booking form, or call or WhatsApp our hosts to arrange a date.</p>
        <a class="btn btn--primary" href={bookingForm} rel="noopener" target="_blank">Open the booking form</a>
      </div>
      <dl class="info">
        <div>
          <dt>Opening hours</dt>
          <dd>Weekdays 9am – 5pm<br />Saturdays 9am – 2pm</dd>
        </div>
        <div>
          <dt>Call or WhatsApp</dt>
          <dd>
            {
              hosts.map((h) => (
                <span class="host">
                  {h.name}:{' '}
                  <a href={`tel:${h.phone.replace(/\s/g, '')}`}>{h.phone}</a> ·{' '}
                  <a href={`https://wa.me/${h.phone.replace(/[^0-9]/g, '')}`} rel="noopener" target="_blank">
                    WhatsApp
                  </a>
                </span>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>Where</dt>
          <dd>HERI Black Soldier Fly Farm, Diani, Kwale County</dd>
        </div>
        <div>
          <dt>Can’t travel?</dt>
          <dd>
            Book a live virtual tour with the form, or <a href="/projects/heri-black-soldier-fly-farm/tour/"
              >take the self-guided virtual tour</a
            > now.
          </dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .modules {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .modules > li {
    padding: 24px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 14px;
    border-radius: 14px;
    background: var(--green-50);
    font-size: 1.6rem;
  }

  .modules h3 {
    font-size: 1.1rem;
  }

  .modules ul {
    margin: 0;
    padding-left: 1.1em;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .modules ul li::marker {
    color: var(--brand);
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pills li {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--white);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .ticks {
    margin: 0 0 20px;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .ticks li {
    position: relative;
    padding-left: 30px;
  }

  .ticks li::before {
    content: '✓';
    position: absolute;
    left: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .book {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .info {
    display: grid;
    gap: 16px;
    margin: 0;
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--navy-900);
    color: var(--white);
  }

  .info dt {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--green-500);
  }

  .info dd {
    margin: 4px 0 0;
  }

  .info a {
    color: var(--white);
  }

  .host {
    display: block;
  }

  @media (max-width: 1023px) {
    .modules {
      grid-template-columns: 1fr 1fr;
    }

    .two,
    .book {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .modules {
      grid-template-columns: 1fr;
    }
  }
</style>
