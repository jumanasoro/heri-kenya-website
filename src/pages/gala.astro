---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Form from '../components/Form.astro';
import { gala, galaHref } from '../data/events';
import { donateHref, externalLink, contact } from '../data/site';

const tba = 'To be announced';
const details = [
  { label: 'Date', value: gala.dateLabel },
  { label: 'Time', value: gala.time ?? tba },
  { label: 'Venue', value: gala.venue ?? tba },
  { label: 'Tickets', value: gala.tickets ?? tba },
  { label: 'Dress code', value: gala.dressCode ?? tba },
];

const ways = [
  {
    title: 'Attend',
    text: 'Reserve seats for yourself, your family or colleagues and celebrate HERI@6 with us.',
  },
  {
    title: 'Sponsor',
    text: 'Sponsor a table or the evening and put your organisation alongside six years of measurable impact.',
  },
  {
    title: 'Donate an item',
    text: 'Contribute a prize, experience or service for the evening’s fundraising.',
  },
  {
    title: 'Give from anywhere',
    text: 'Can’t make it to the gala? A gift online still counts towards the HERI@6 goal.',
  },
];
---

<Base
  title={gala.title}
  description={`${gala.title}, ${gala.dateLabel}. ${gala.tagline}. Reserve your seat, sponsor a table or donate.`}
>
  <PageHero
    eyebrow="Annual fundraising gala"
    title={gala.title}
    lead={gala.intro}
    image={gala.image}
    imageAlt={gala.imageAlt}
    crumbs={[{ label: 'Gala', href: galaHref }]}
  >
    <div class="btn-row">
      <a class="btn btn--primary" href={gala.ticketLink ?? '#rsvp'} {...(gala.ticketLink ? externalLink : {})}>
        Reserve your seat
      </a>
      <a class="btn btn--outline" href={donateHref} {...externalLink}>Donate</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container two">
      <div>
        <span class="eyebrow">The evening</span>
        <h2>Event details</h2>
        <dl class="details">
          {
            details.map((d) => (
              <div>
                <dt>{d.label}</dt>
                <dd class:list={{ tba: d.value === tba }}>{d.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          gala.programme ? (
            <>
              <h3 class="sub">Programme</h3>
              <ol class="programme">
                {gala.programme.map((p) => (
                  <li>
                    <span>{p.time}</span> {p.item}
                  </li>
                ))}
              </ol>
            </>
          ) : (
            <p class="note">The full programme will be shared here soon.</p>
          )
        }
      </div>
      <div class="supports">
        <span class="eyebrow">Your support makes possible</span>
        <h2>What the gala will fund</h2>
        <ul>
          {gala.supports.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Get involved</span>
        <h2>Four ways to be part of the night</h2>
      </div>
      <ul class="ways">
        {
          ways.map((w) => (
            <li>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="rsvp">
    <div class="container two">
      <div>
        <span class="eyebrow">RSVP</span>
        <h2>Reserve your seat or sponsor the gala</h2>
        <p class="lead">
          Tell us how you’d like to take part and we’ll confirm your booking, ticket details and payment options.
        </p>
        <p>
          Questions? Email <a href={`mailto:${contact.email}?subject=${encodeURIComponent(gala.title)}`}>{contact.email}</a>
          or call {contact.phone}.
        </p>
      </div>
      <div class="panel">
        <Form
          form="gala-rsvp"
          submitLabel="Send RSVP"
          fields={[
            { name: 'name', label: 'Full name', type: 'text', required: true, autocomplete: 'name' },
            { name: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
            { name: 'phone', label: 'Phone', type: 'tel', autocomplete: 'tel' },
            { name: 'organisation', label: 'Organisation (optional)', type: 'text', autocomplete: 'organization' },
            {
              name: 'interest',
              label: 'I’d like to',
              type: 'select',
              required: true,
              options: ['Attend', 'Sponsor a table or the evening', 'Donate an item', 'Find out more'],
            },
            {
              name: 'seats',
              label: 'Number of seats',
              type: 'select',
              options: ['1', '2', '3', '4', '5', '6–10 (a table)', 'More than 10'],
            },
            { name: 'message', label: 'Anything else?', type: 'textarea' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .details {
    display: grid;
    gap: 2px;
    margin: 0 0 20px;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .details div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 16px;
    padding: 14px 18px;
    background: var(--surface-soft);
  }

  dt {
    font-weight: 700;
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    font-weight: 600;
  }

  dd.tba {
    color: var(--slate-500);
    font-weight: 500;
    font-style: italic;
  }

  .sub {
    margin-top: 24px;
  }

  .programme {
    margin: 0;
    padding-left: 1.2em;
  }

  .programme span {
    font-weight: 700;
    color: var(--brand-strong);
  }

  .note {
    color: var(--text-muted);
  }

  .supports {
    padding: clamp(24px, 4vw, 36px);
    border-radius: var(--radius-lg);
    background: var(--navy-900);
    color: var(--white);
  }

  .supports .eyebrow {
    color: var(--sun-400);
  }

  .supports h2 {
    color: var(--white);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .supports ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .supports li {
    position: relative;
    padding-left: 30px;
  }

  .supports li::before {
    content: '✓';
    position: absolute;
    left: 0;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sun-400);
    color: var(--navy-900);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ways li {
    padding: 24px;
    border-radius: var(--radius);
    background: var(--white);
    border-top: 5px solid var(--sun-400);
  }

  .ways h3 {
    font-size: 1.15rem;
  }

  .ways p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .panel {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  @media (max-width: 1023px) {
    .two {
      grid-template-columns: 1fr;
    }

    .ways {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 639px) {
    .ways {
      grid-template-columns: 1fr;
    }

    .details div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
