---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Form from '../components/Form.astro';
import { partners } from '../data/site';
import { Image } from 'astro:assets';
import heroImage from '../assets/images/home/hotel-partners-organic-waste.jpg';

const ways = [
  {
    title: 'Organic waste partnership',
    text: 'Send your kitchen’s sorted food waste to the BSF Farm. We train your staff, provide “Organic waste only” guidance and help you report the waste you divert.',
    for: 'Hotels, restaurants, markets',
  },
  {
    title: 'CSR & ESG packages',
    text: 'Fund a defined package — a school eco-club, a community forum series, tree planting or farm expansion — with clear outcomes you can report.',
    for: 'Businesses and brands',
  },
  {
    title: 'Research collaboration',
    text: 'Partner on applied studies in environmental health, vector-borne disease, waste and the circular economy, with field placements for students.',
    for: 'Universities and research institutes',
  },
  {
    title: 'Programme partnership',
    text: 'Co-design and co-fund integrated programmes through the Diani Sustainability Collective — one coordinated platform, measurable results.',
    for: 'Donors, foundations and government',
  },
];

const benefits = [
  'Measurable impact you can include in sustainability and ESG reporting',
  'A credible, science-led partner with deep community roots',
  'Visibility as a leader in responsible tourism in Diani',
  'Staff engagement through volunteering days and farm visits',
  'Help meeting waste regulations and Extended Producer Responsibility goals',
];

const steps = [
  { title: 'Talk to us', text: 'Tell us your goals, budget and timelines.' },
  { title: 'Design together', text: 'We propose a package matched to local needs and your priorities.' },
  { title: 'Deliver & measure', text: 'We run the work and track outcomes from day one.' },
  { title: 'Report', text: 'You receive clear updates and results to share.' },
];
---

<Base
  title="CSR & Partnerships"
  description="Partner with HERI-Kenya: organic waste partnerships for hotels, CSR and ESG packages, research collaborations and programme partnerships in Diani."
>
  <PageHero
    eyebrow="CSR & partnerships"
    title="Build a cleaner, healthier Diani — with measurable results"
    lead="We work with hotels, businesses, researchers and donors on partnerships that fund real community impact and strengthen your sustainability story."
    image={heroImage}
    imageAlt="Hotel kitchen staff and a chef hold a HERI 'Organic waste only' sign"
    crumbs={[{ label: 'CSR & Partnerships', href: '/partnerships-csr/' }]}
  >
    <a class="btn btn--primary" href="#enquire">Start a conversation</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ways to partner</span>
        <h2>Choose the partnership that fits</h2>
      </div>
      <ul class="ways">
        {
          ways.map((w) => (
            <li>
              <span class="for">{w.for}</span>
              <h3>{w.title}</h3>
              <p>{w.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container two">
      <div>
        <span class="eyebrow">Why partner with HERI</span>
        <h2>What partners gain</h2>
        <ul class="benefits">
          {benefits.map((b) => <li>{b}</li>)}
        </ul>
      </div>
      <div>
        <span class="eyebrow">How it works</span>
        <h2>Four simple steps</h2>
        <ol class="steps">
          {
            steps.map((s, i) => (
              <li>
                <span>{i + 1}</span>
                <div>
                  <strong>{s.title}</strong>
                  <p>{s.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="partners-band" aria-labelledby="pt">
    <div class="container">
      <h2 id="pt" class="pt">Already working with us</h2>
      <ul class="logos">
        {
          partners.map((p) => (
            <li>
              <Image src={p.logo} alt={p.name} height={64} widths={[160, 320]} sizes="160px" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" id="enquire">
    <div class="container two">
      <div>
        <span class="eyebrow">Enquire</span>
        <h2>Let’s talk about your goals</h2>
        <p class="lead">Tell us a little about your organisation and we’ll follow up with ideas and options.</p>
        <p>
          Prefer to see the work first? <a href="/learning-eco-tours/">Book a visit to the BSF Farm</a> or
          <a href="/projects/diani-sustainability-collective/">read about the Diani Sustainability Collective</a>.
        </p>
      </div>
      <div class="panel">
        <Form
          form="partnership"
          submitLabel="Send enquiry"
          fields={[
            { name: 'name', label: 'Your name', type: 'text', required: true, autocomplete: 'name' },
            { name: 'email', label: 'Work email', type: 'email', required: true, autocomplete: 'email' },
            { name: 'organisation', label: 'Organisation', type: 'text', required: true, autocomplete: 'organization' },
            { name: 'phone', label: 'Phone (optional)', type: 'tel', autocomplete: 'tel' },
            {
              name: 'interest',
              label: 'I’m interested in',
              type: 'select',
              options: [...ways.map((w) => w.title), 'Something else'],
            },
            { name: 'message', label: 'Tell us more', type: 'textarea' },
          ]}
        />
      </div>
    </div>
  </section>
</Base>

<style>
  .ways {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ways li {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }

  .for {
    display: inline-block;
    margin-bottom: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--green-50);
    color: var(--brand-strong);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .ways h3 {
    font-size: 1.3rem;
  }

  .ways p {
    margin: 0;
    color: var(--text-muted);
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .benefits {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  .benefits li {
    position: relative;
    padding-left: 32px;
  }

  .benefits li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 1px;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .steps li {
    display: flex;
    gap: 16px;
    padding: 18px 20px;
    border-radius: var(--radius);
    background: var(--white);
  }

  .steps li > span {
    display: grid;
    place-items: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--white);
    font-weight: 800;
  }

  .steps p {
    margin: 0;
    color: var(--text-muted);
  }

  .partners-band {
    padding-block: 48px;
    border-bottom: 1px solid var(--border);
  }

  .pt {
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: center;
    color: var(--slate-500);
    margin-bottom: 28px;
  }

  .logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 24px 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .logos img {
    height: 52px;
    width: auto;
    max-width: 150px;
    object-fit: contain;
  }

  .panel {
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow);
  }

  @media (max-width: 1023px) {
    .two {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .ways {
      grid-template-columns: 1fr;
    }
  }
</style>
