---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---

<Base title="Page not found" description="This page could not be found on the HERI-Kenya website.">
  <PageHero
    eyebrow="404 · Page not found"
    title="This page has wandered off"
    lead="It may have moved when we rebuilt our website. Try one of these instead."
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="/">Home</a>
      <a class="btn btn--outline" href="/projects/">Our Work</a>
      <a class="btn btn--outline" href="/contact-us/">Contact us</a>
    </div>
  </PageHero>
</Base>
