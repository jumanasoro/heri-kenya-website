---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { givingMethods, giftImpact } from '../data/donate';
import { contact, stats } from '../data/site';
import heroImage from '../assets/images/home/tree-planting.jpg';

const pending = givingMethods.filter((m) => !m.details && !m.link);
if (pending.length > 0) {
  console.warn(`[support] Donation details still missing for: ${pending.map((m) => m.name).join(', ')}`);
}
---

<Base
  title="Support Us"
  description="Donate to HERI-Kenya by M-Pesa, bank transfer, PayPal or card, or through Social Good Fund, and help scale community health and environmental solutions in Diani."
>
  <PageHero
    eyebrow="Support HERI@5"
    title="Your gift turns waste into opportunity"
    lead="As we celebrate five years, we are mobilising support to scale our waste management work, community reach and impact on environmental health and sustainability."
    image={heroImage}
    imageAlt="A HERI eco-club member holds a tree seedling"
    crumbs={[{ label: 'Support Us', href: '/support/' }]}
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="#give">Ways to give</a>
      <a class="btn btn--outline" href="/partnerships-csr/">Corporate partnerships</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Where your money goes</span>
        <h2>Every gift funds work you can see</h2>
      </div>
      <ul class="impact">
        {
          giftImpact.map((g, i) => (
            <li>
              <span class="n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{g.title}</h3>
              <p>{g.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="give" class="section section--soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ways to give</span>
        <h2>Choose the option that suits you</h2>
        <p class="lead">Whether you are in Kenya or abroad, giving takes a few minutes.</p>
      </div>

      <ul class="methods">
        {
          givingMethods.map((m) => (
            <li class="method" id={m.id}>
              <h3>{m.name}</h3>
              <p class="best">{m.bestFor}</p>
              {m.details && (
                <dl>
                  {m.details.map((d) => (
                    <div>
                      <dt>{d.label}</dt>
                      <dd>{d.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
              {m.link && (
                <a class="btn btn--primary" href={m.link.href} rel="noopener" target="_blank">
                  {m.link.label}
                </a>
              )}
              {!m.details && !m.link && (
                <p class="pending">
                  Details coming soon. In the meantime, email{' '}
                  <a href={`mailto:${contact.email}?subject=${encodeURIComponent(`Donation via ${m.name}`)}`}>
                    {contact.email}
                  </a>
                  .
                </p>
              )}
              {m.note && <p class="note">{m.note}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container trust">
      <div>
        <span class="eyebrow">Accountability</span>
        <h2>Science-led, community-driven, transparent</h2>
        <p class="lead">
          HERI-Kenya is a non-profit community benefit organisation founded in 2021. We track outcomes, learn
          continuously and report on what changed.
        </p>
        <p>
          Questions about a gift, receipts or giving through your company or foundation? Email
          <a href={`mailto:${contact.email}`}>{contact.email}</a> or call {contact.phone}.
        </p>
      </div>
      <ul class="trust-stats">
        {
          stats.slice(0, 4).map((s) => (
            <li>
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .impact {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .impact li {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .n {
    font-family: var(--font-heading);
    font-weight: 800;
    color: var(--brand);
  }

  .impact h3 {
    margin: 8px 0 6px;
  }

  .impact p {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.975rem;
  }

  .methods {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .method {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--white);
    scroll-margin-top: 96px;
  }

  .method h3 {
    font-size: 1.4rem;
    margin-bottom: 2px;
  }

  .best {
    color: var(--text-muted);
  }

  dl {
    display: grid;
    gap: 8px;
    margin: 0 0 16px;
    width: 100%;
  }

  dl div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 14px;
    border-radius: var(--radius-sm);
    background: var(--green-50);
  }

  dt {
    color: var(--text-muted);
  }

  dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-align: right;
  }

  .pending {
    margin: 0;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    background: var(--green-50);
    font-size: 0.95rem;
  }

  .note {
    margin: 12px 0 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .trust {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: center;
  }

  .trust-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trust-stats li {
    display: grid;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--surface-soft);
  }

  .trust-stats strong {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 800;
    color: var(--brand-strong);
  }

  .trust-stats span {
    color: var(--text-muted);
  }

  @media (max-width: 1023px) {
    .impact {
      grid-template-columns: 1fr 1fr;
    }

    .trust {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 639px) {
    .impact,
    .methods {
      grid-template-columns: 1fr;
    }
  }
</style>
