---
import { donateHref } from '../data/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Help us scale what works',
  text = 'Your support funds waste solutions, community training and research that improve health and the environment on Kenya’s coast.',
} = Astro.props;
---

<section class="section">
  <div class="container band">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--light" href={donateHref}>Donate</a>
      <a class="btn btn--ghost-light" href="/partnerships-csr/">Partner with us</a>
    </div>
  </div>
</section>

<style>
  .band {
    display: grid;
    grid-template-columns: 1.4fr auto;
    align-items: center;
    gap: 32px;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background: linear-gradient(120deg, var(--green-700), var(--navy-900));
    color: var(--white);
  }

  h2 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
  }

  p {
    margin: 0;
    max-width: 56ch;
    color: rgb(255 255 255 / 0.85);
  }

  @media (max-width: 767px) {
    .band {
      grid-template-columns: 1fr;
    }
  }
</style>
