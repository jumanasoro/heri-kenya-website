---
import { Image } from 'astro:assets';
import { formatDate, type NewsItem } from '../lib/news';

interface Props {
  item: NewsItem;
  featured?: boolean;
}

const { item, featured = false } = Astro.props;
---

<a
  class:list={['card', { 'card--featured': featured }]}
  href={item.href}
  {...item.external ? { target: '_blank', rel: 'noopener' } : {}}
>
  {
    item.cover ? (
      <Image
        src={item.cover}
        alt={item.coverAlt ?? ''}
        widths={featured ? [600, 1000] : [400, 700]}
        sizes={featured ? '(max-width: 1023px) 100vw, 600px' : '(max-width: 639px) 100vw, 380px'}
      />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <span>{item.category}</span>
      </div>
    )
  }
  <div class="body">
    <p class="meta">
      <span class:list={['tag', `tag--${item.category.toLowerCase()}`]}>{item.category}</span>
      <time datetime={item.date.toISOString().slice(0, 10)}>{formatDate(item.date)}</time>
    </p>
    <h3>{item.title}</h3>
    <p class="summary">{item.summary}</p>
    <span class="link-arrow">Read more</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  img,
  .placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--white);
  }

  .placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--green-700), var(--navy-900));
  }

  .placeholder span {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 800;
    color: rgb(255 255 255 / 0.85);
  }

  .card--featured {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
  }

  .card--featured img,
  .card--featured .placeholder {
    aspect-ratio: auto;
    height: 100%;
    min-height: 280px;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 24px 24px;
  }

  .card--featured .body {
    justify-content: center;
    padding: clamp(24px, 4vw, 40px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    font-size: 0.85rem;
    color: var(--slate-500);
  }

  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--green-50);
    color: var(--brand-strong);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .tag--award {
    background: #fef3c7;
    color: #92400e;
  }

  .tag--event {
    background: #e0f2fe;
    color: #075985;
  }

  h3 {
    margin-bottom: 8px;
  }

  .card--featured h3 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
  }

  .summary {
    flex: 1;
    color: var(--text-muted);
    font-size: 0.975rem;
  }

  @media (max-width: 1023px) {
    .card--featured {
      grid-template-columns: 1fr;
    }

    .card--featured img,
    .card--featured .placeholder {
      aspect-ratio: 16 / 10;
      min-height: 0;
    }
  }
</style>
