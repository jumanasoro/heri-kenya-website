---
// Full-width homepage hero: a photo slideshow with the headline and buttons on top.
import { Image } from 'astro:assets';
import { heroSlides } from '../data/hero-slides';
import { donateHref, externalLink } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="slides" aria-roledescription="carousel" aria-label="Photos of HERI's work">
    {
      heroSlides.map((s, i) => (
        <figure
          class:list={['slide', { 'is-active': i === 0 }]}
          aria-roledescription="slide"
          aria-label={`${i + 1} of ${heroSlides.length}`}
          aria-hidden={i === 0 ? undefined : 'true'}
          data-slide
        >
          <Image
            src={s.image}
            alt={s.alt}
            widths={[640, 1024, 1600, 2000]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            style={s.focus ? `object-position: ${s.focus}` : undefined}
          />
          <figcaption>{s.caption}</figcaption>
        </figure>
      ))
    }
  </div>

  <div class="container content">
    <p class="badge"><strong>HERI@6</strong> Six years of science-driven community impact</p>
    <span class="eyebrow">Health + Environmental Research Institute – Kenya</span>
    <h1 id="hero-title">Healthier <span class="accent">Environments and Communities</span></h1>
    <p class="lead">
      We connect science with communities and stakeholders, turning research into grassroots action for better health
      and a sustainable environment.
    </p>
    <div class="btn-row">
      <a class="btn btn--primary" href={donateHref} {...externalLink}>Support our work</a>
      <a class="btn btn--ghost-light" href="/projects/">See what we do</a>
    </div>
  </div>

  <div class="controls">
    <button type="button" class="ctrl" data-prev aria-label="Previous photo">‹</button>
    <div class="dots">
      {
        heroSlides.map((s, i) => (
          <button
            type="button"
            class="dot"
            data-dot={i}
            aria-label={`Show photo ${i + 1}: ${s.caption}`}
            aria-current={i === 0 ? 'true' : undefined}
          />
        ))
      }
    </div>
    <button type="button" class="ctrl" data-next aria-label="Next photo">›</button>
    <button type="button" class="ctrl ctrl--pause" data-pause aria-label="Pause slideshow" aria-pressed="false">
      <span class="pause-icon" aria-hidden="true"></span>
    </button>
  </div>
</section>

<script>
  const INTERVAL = 6000;

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = [...hero.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...hero.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-pause]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    // Paused by the visitor (button) vs. temporarily (hover, focus, hidden tab).
    let userPaused = reduceMotion;
    let holdCount = 0;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const active = i === current;
        s.classList.toggle('is-active', active);
        if (active) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((d, i) => {
        if (i === current) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
    };

    const schedule = () => {
      window.clearTimeout(timer);
      if (!userPaused && holdCount === 0 && !document.hidden) {
        timer = window.setTimeout(() => {
          show(current + 1);
          schedule();
        }, INTERVAL);
      }
    };

    const setPaused = (paused: boolean) => {
      userPaused = paused;
      hero.classList.toggle('is-paused', paused);
      pauseBtn?.setAttribute('aria-pressed', String(paused));
      pauseBtn?.setAttribute('aria-label', paused ? 'Play slideshow' : 'Pause slideshow');
      schedule();
    };

    hero.querySelector('[data-prev]')?.addEventListener('click', () => {
      show(current - 1);
      schedule();
    });
    hero.querySelector('[data-next]')?.addEventListener('click', () => {
      show(current + 1);
      schedule();
    });
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        show(i);
        schedule();
      }),
    );
    pauseBtn?.addEventListener('click', () => setPaused(!userPaused));

    const hold = (on: boolean) => {
      holdCount = Math.max(0, holdCount + (on ? 1 : -1));
      schedule();
    };
    hero.addEventListener('mouseenter', () => hold(true));
    hero.addEventListener('mouseleave', () => hold(false));
    hero.addEventListener('focusin', () => hold(true));
    hero.addEventListener('focusout', () => hold(false));
    document.addEventListener('visibilitychange', schedule);

    setPaused(userPaused);
  });
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    min-height: clamp(520px, 82vh, 780px);
    padding-block: clamp(48px, 7vw, 96px) clamp(88px, 10vw, 120px);
    overflow: hidden;
    color: var(--white);
    background: var(--navy-900);
  }

  .slides,
  .slide {
    position: absolute;
    inset: 0;
    margin: 0;
  }

  .slides {
    z-index: -2;
  }

  .slide {
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .slide.is-active {
    opacity: 1;
  }

  .slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 7s ease-out;
  }

  /* Gentle zoom on the photo being shown. */
  .slide.is-active img {
    transform: scale(1);
  }

  /* Darken the photos so white text stays readable. */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(15 23 42 / 0.88) 0%, rgb(15 23 42 / 0.6) 45%, rgb(15 23 42 / 0.1) 80%),
      linear-gradient(0deg, rgb(15 23 42 / 0.55), transparent 35%);
  }

  /* Top-right, so the floating WhatsApp button never covers it. */
  figcaption {
    position: absolute;
    right: var(--gutter);
    top: 20px;
    max-width: 40ch;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgb(15 23 42 / 0.55);
    color: rgb(255 255 255 / 0.9);
    font-size: 0.85rem;
    text-align: right;
  }

  .content {
    position: relative;
  }

  .content > * {
    max-width: 640px;
  }

  .badge {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    margin-bottom: 18px;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.25);
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.9);
  }

  .badge strong {
    color: var(--sun-400);
  }

  .eyebrow {
    display: block;
    color: var(--green-500);
  }

  h1 {
    color: var(--white);
  }

  .accent {
    color: #7bd65a;
  }

  .lead {
    color: rgb(255 255 255 / 0.88);
    margin-bottom: 32px;
  }

  .controls {
    position: absolute;
    left: 50%;
    bottom: 24px;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    width: min(100% - 2 * var(--gutter), var(--container));
    transform: translateX(-50%);
  }

  .dots {
    display: flex;
    gap: 6px;
  }

  .dot {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    position: relative;
  }

  .dot::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    transform: translate(-50%, -50%);
    transition: width 0.3s, background-color 0.3s;
  }

  .dot[aria-current='true']::before {
    width: 26px;
    background: var(--white);
  }

  .ctrl {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: rgb(15 23 42 / 0.35);
    color: var(--white);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .ctrl:hover {
    background: rgb(15 23 42 / 0.6);
  }

  .pause-icon {
    width: 12px;
    height: 14px;
    border-inline: 4px solid var(--white);
  }

  /* When paused, show a play triangle instead. */
  .hero:global(.is-paused) .pause-icon {
    width: 0;
    height: 0;
    border-block: 8px solid transparent;
    border-inline: 13px solid var(--white);
    border-inline-end: 0;
    margin-left: 3px;
  }

  @media (max-width: 767px) {
    .hero {
      align-items: flex-end;
      min-height: clamp(560px, 88vh, 720px);
    }

    .hero::after {
      background: linear-gradient(0deg, rgb(15 23 42 / 0.92) 0%, rgb(15 23 42 / 0.65) 50%, rgb(15 23 42 / 0.25) 100%);
    }

    figcaption {
      top: 14px;
      right: 14px;
      font-size: 0.75rem;
    }

    .badge {
      font-size: 0.8rem;
    }

    /* Dots are enough on phones; this keeps the controls clear of the WhatsApp button. */
    .ctrl[data-prev],
    .ctrl[data-next] {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide img {
      transition: none;
    }

    .slide img {
      transform: none;
    }
  }
</style>
