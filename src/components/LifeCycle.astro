---
import { lifecycleStages } from '../data/bsf-tour';
---

<figure class="cycle" aria-labelledby="cycle-caption">
  <ol>
    {
      lifecycleStages.map((stage, i) => (
        <li>
          <svg viewBox="0 0 120 80" aria-hidden="true" class="art">
            {i === 0 && (
              <g fill="#f8f5e6" stroke="#cbbf8f" stroke-width="1.5">
                <ellipse cx="44" cy="40" rx="6" ry="9" />
                <ellipse cx="58" cy="36" rx="6" ry="9" />
                <ellipse cx="72" cy="42" rx="6" ry="9" />
                <ellipse cx="52" cy="52" rx="6" ry="9" />
                <ellipse cx="66" cy="55" rx="6" ry="9" />
              </g>
            )}
            {i === 1 && (
              <g>
                <rect x="22" y="30" width="76" height="22" rx="11" fill="#f3efe0" stroke="#bfb48a" stroke-width="1.5" />
                <g stroke="#cfc59f" stroke-width="1.5">
                  <line x1="38" y1="31" x2="38" y2="51" />
                  <line x1="50" y1="31" x2="50" y2="51" />
                  <line x1="62" y1="31" x2="62" y2="51" />
                  <line x1="74" y1="31" x2="74" y2="51" />
                  <line x1="86" y1="32" x2="86" y2="50" />
                </g>
                <circle cx="96" cy="41" r="6" fill="#2b2b2b" />
              </g>
            )}
            {i === 2 && (
              <g>
                <rect x="22" y="30" width="76" height="22" rx="11" fill="#5b4632" stroke="#3e2f21" stroke-width="1.5" />
                <g stroke="#6f5840" stroke-width="1.5">
                  <line x1="38" y1="31" x2="38" y2="51" />
                  <line x1="50" y1="31" x2="50" y2="51" />
                  <line x1="62" y1="31" x2="62" y2="51" />
                  <line x1="74" y1="31" x2="74" y2="51" />
                  <line x1="86" y1="32" x2="86" y2="50" />
                </g>
                <circle cx="96" cy="41" r="6" fill="#1d1d1d" />
              </g>
            )}
            {i === 3 && (
              <g>
                <path d="M26 41c0-10 14-15 34-15s34 5 34 15-14 15-34 15-34-5-34-15z" fill="#3b2a1c" />
                <g stroke="#5a4330" stroke-width="1.5" fill="none">
                  <path d="M42 28v26M54 26v30M66 26v30M78 28v26" />
                </g>
              </g>
            )}
            {i === 4 && (
              <g>
                <path d="M60 36 C 40 14, 20 18, 26 30 C 30 38, 48 40, 60 38z" fill="rgb(180 200 220 / 0.55)" stroke="#8aa0b4" />
                <path d="M62 36 C 82 14, 102 18, 96 30 C 92 38, 74 40, 62 38z" fill="rgb(180 200 220 / 0.55)" stroke="#8aa0b4" />
                <ellipse cx="61" cy="48" rx="9" ry="20" fill="#151515" />
                <rect x="55" y="52" width="12" height="4" rx="2" fill="#e8f0f6" />
                <circle cx="61" cy="26" r="7" fill="#1d1d1d" />
                <path d="M57 21 L50 10 M65 21 L72 10" stroke="#1d1d1d" stroke-width="2" stroke-linecap="round" />
              </g>
            )}
          </svg>
          <span class="num">{i + 1}</span>
          <strong>{stage.name}</strong>
          <span class="time">{stage.time}</span>
        </li>
      ))
    }
  </ol>
  <figcaption id="cycle-caption">
    The Black Soldier Fly life cycle. The larvae (stage 2) are the waste-eaters; adults lay new eggs and the cycle starts
    again.
  </figcaption>
</figure>

<style>
  .cycle {
    margin: 0;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid var(--border);
  }

  ol {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
    counter-reset: stage;
  }

  li {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 2px;
    padding: 12px 6px;
    border-radius: var(--radius);
    background: var(--green-50);
  }

  li:nth-child(2) {
    background: var(--green-100);
    outline: 2px solid var(--green-500);
  }

  /* Arrow between stages */
  li:not(:last-child)::after {
    content: '→';
    position: absolute;
    right: -10px;
    top: 34%;
    z-index: 1;
    color: var(--brand);
    font-weight: 800;
  }

  .art {
    width: 100%;
    max-width: 110px;
    height: auto;
  }

  .num {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--brand);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
  }

  strong {
    font-family: var(--font-heading);
    font-size: 0.95rem;
  }

  .time {
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  figcaption {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  @media (max-width: 639px) {
    ol {
      grid-template-columns: 1fr;
    }

    li {
      grid-template-columns: 90px 1fr;
      justify-items: start;
      text-align: left;
      column-gap: 14px;
      padding: 10px 14px;
    }

    .art {
      grid-row: span 3;
      align-self: center;
    }

    li:not(:last-child)::after {
      content: '↓';
      right: auto;
      left: 50%;
      top: auto;
      bottom: -14px;
    }
  }
</style>
