---
// "How we work": research -> community action -> measurable impact. Shown on the Our Work page.
import { site } from '../data/site';

const approach = [
  {
    step: '01',
    title: 'Research',
    text: 'Assessments, surveys and applied studies make sure every intervention is relevant, ethical and effective.',
  },
  {
    step: '02',
    title: 'Community action',
    text: 'We turn evidence into targeted projects on waste, environmental health and community capacity — with communities, not for them.',
  },
  {
    step: '03',
    title: 'Measurable impact',
    text: 'We track outcomes, learn continuously and adapt, so partners and donors can see exactly what changed.',
  },
];
---

<section class="section section--soft" aria-labelledby="approach-title">
  <div class="container approach">
    <div class="section-head">
      <span class="eyebrow">How we work</span>
      <h2 id="approach-title">Evidence first. Community always.</h2>
      <p class="lead">
        Founded in {site.founded} by researchers from KEMRI, Stanford University and the Technical University of Mombasa,
        HERI puts science to work where it matters most.
      </p>
    </div>
    <ol class="steps">
      {
        approach.map((a) => (
          <li>
            <span class="step-num">{a.step}</span>
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .approach {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  .approach .section-head {
    margin-bottom: 0;
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 16px;
  }

  .steps li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 20px;
    padding: 24px;
    background: var(--white);
    border-radius: var(--radius);
  }

  .step-num {
    grid-row: span 2;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--brand);
  }

  .steps h3 {
    margin-bottom: 4px;
  }

  .steps p {
    margin: 0;
    color: var(--text-muted);
  }

  @media (max-width: 1023px) {
    .approach {
      grid-template-columns: 1fr;
    }
  }
</style>
