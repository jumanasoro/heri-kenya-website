---
// Slim banner above the header on every page, advertising the gala until it has passed.
import { gala, galaHref } from '../data/events';

const visible = new Date() < new Date(gala.showUntil);
---

{
  visible && (
    <div class="announce" data-announce data-until={gala.showUntil}>
      <a href={galaHref}>
        <span class="tag">Save the date</span>
        <span class="text">
          <strong>{gala.title}</strong> · {gala.dateLabel}
        </span>
        <span class="more">Find out more →</span>
      </a>
    </div>
  )
}

<script>
  // The site is built ahead of time, so also hide the banner in the browser once the gala has passed.
  document.querySelectorAll<HTMLElement>('[data-announce]').forEach((el) => {
    const until = el.dataset.until;
    if (until && new Date() >= new Date(until)) el.remove();
  });
</script>

<style>
  .announce {
    background: var(--navy-900);
    color: var(--white);
    font-size: 0.9rem;
  }

  a {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 12px;
    padding: 9px var(--gutter);
    color: inherit;
    text-decoration: none;
    text-align: center;
  }

  a:hover .more {
    text-decoration: underline;
  }

  .tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--sun-400);
    color: var(--navy-900);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  strong {
    color: var(--white);
  }

  .more {
    color: #7bd65a;
    font-weight: 700;
  }

  @media (max-width: 639px) {
    .announce {
      font-size: 0.8rem;
    }

    .more {
      display: none;
    }
  }
</style>
