---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  image?: ImageMetadata;
  tag?: string;
}

const { title, summary, href, image, tag } = Astro.props;
---

<a class="card" href={href}>
  {
    image ? (
      <Image src={image} alt="" widths={[400, 700]} sizes="(max-width: 767px) 100vw, 380px" />
    ) : (
      <div class="placeholder" aria-hidden="true">
        <span>{title.charAt(0)}</span>
      </div>
    )
  }
  <div class="body">
    {tag && <span class="tag">{tag}</span>}
    <h3>{title}</h3>
    <p>{summary}</p>
    <span class="link-arrow">Learn more</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    height: 100%;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--border);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  img,
  .placeholder {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 30% 30%, var(--green-500), transparent 60%),
      linear-gradient(135deg, var(--green-700), var(--navy-900));
  }

  .placeholder span {
    font-family: var(--font-heading);
    font-size: 4rem;
    font-weight: 800;
    color: rgb(255 255 255 / 0.85);
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 20px 24px 24px;
  }

  .tag {
    align-self: flex-start;
    margin-bottom: 10px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--green-50);
    color: var(--brand-strong);
    font-size: 0.8rem;
    font-weight: 600;
  }

  h3 {
    margin-bottom: 6px;
  }

  p {
    flex: 1;
    font-size: 0.975rem;
    color: var(--text-muted);
  }
</style>
