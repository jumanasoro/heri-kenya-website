---
import { Image } from 'astro:assets';
import type { Person } from '../data/team';

interface Props {
  person: Person;
  size?: 'large' | 'small';
}

const { person, size = 'small' } = Astro.props;
const initials = person.name
  .replace(/^(Prof\.|Dr\.)\s*/, '')
  .split(' ')
  .map((w) => w[0])
  .slice(0, 2)
  .join('');
---

<article class:list={['person', `person--${size}`]}>
  {
    person.photo ? (
      <Image
        src={person.photo}
        alt={`Portrait of ${person.name}`}
        widths={size === 'large' ? [240, 480] : [160, 320]}
        sizes={size === 'large' ? '240px' : '160px'}
        style={person.focus ? `object-position: ${person.focus}` : undefined}
      />
    ) : (
      <div class="initials" aria-hidden="true">
        {initials}
      </div>
    )
  }
  <div>
    <h3>{person.name}</h3>
    <p class="role">{person.role}</p>
    {person.bio && <p class="bio">{person.bio}</p>}
  </div>
</article>

<style>
  .person {
    display: grid;
    gap: 16px;
    text-align: center;
    justify-items: center;
  }

  img,
  .initials {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--green-50);
  }

  .person--large {
    justify-items: start;
    text-align: left;
    padding: 28px;
    border-radius: var(--radius);
    background: var(--white);
    border: 1px solid var(--border);
  }

  .person--large img,
  .person--large .initials {
    width: 120px;
    height: 120px;
  }

  .initials {
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 2rem;
    color: var(--brand-strong);
  }

  h3 {
    margin-bottom: 2px;
    font-size: 1.1rem;
  }

  .role {
    margin: 0;
    color: var(--brand-strong);
    font-weight: 600;
    font-size: 0.925rem;
  }

  .bio {
    margin: 12px 0 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
